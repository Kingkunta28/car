{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.rafikicarhire.com/api/:path*" },
    { "source": "/media/:path*", "destination": "https://api.rafikicarhire.com/media/:path*" },
    { "source": "/sitemap.xml", "destination": "https://api.rafikicarhire.com/sitemap.xml" },
    { "source": "/((?!assets/|media/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
    ]}
  ]
}
