# ---------------------------------------------------------------
# Rafiki Car Hire backend — copy to .env (local) or set in your host.
# NEVER commit real values.
# ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.prod     # config.settings.dev locally
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.rafikicarhire.com
DJANGO_ADMIN_URL=django-admin/                  # change to something unguessable in production

# Direct Neon endpoint: use for schema migrations and TEST_DATABASE_URL.
DATABASE_URL=postgres://USER:PASSWORD@DIRECT-HOST:5432/rafiki?sslmode=require
# Pooled Neon endpoint: use for normal web traffic.
DATABASE_URL_POOLED=postgres://USER:PASSWORD@POOLER-HOST:5432/rafiki?sslmode=require
# Direct URL on an isolated Neon test branch. Django creates and drops a test database.
TEST_DATABASE_URL=postgres://USER:PASSWORD@TEST-BRANCH-DIRECT-HOST:5432/rafiki?sslmode=require

# Public URLs
FRONTEND_URL=https://www.rafikicarhire.com
BACKEND_URL=https://api.rafikicarhire.com
CSRF_TRUSTED_ORIGINS=https://www.rafikicarhire.com
CORS_ALLOWED_ORIGINS=https://www.rafikicarhire.com

# Redis (Celery broker, cache, rate limiting)
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False                  # True locally if you have no Redis

# Email (SMTP — e.g. Brevo smtp-relay.brevo.com:587, Resend smtp.resend.com:587)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Rafiki Car Hire <bookings@rafikicarhire.com>
OWNER_NOTIFICATION_EMAIL=owner@rafikicarhire.com

# Business rules
BOOKING_HOLD_HOURS=24
BOOKING_TURNAROUND_HOURS=2
BOOKING_MIN_LEAD_HOURS=3
BOOKING_ACCESS_TOKEN_DAYS=120
DOCUMENT_RETENTION_DAYS=30
MAX_UPLOAD_SIZE_MB=8

# Payments — online payments are off by default; set to pesapal to enable Pesapal API 3.0
PAYMENT_GATEWAYS_ENABLED=disabled
PESAPAL_ENV=sandbox                             # live in production
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=                                 # from: python manage.py register_pesapal_ipn

# Optional durable S3-compatible object storage. On Render, enable this after
# provisioning the rafiki-public and rafiki-private Neon buckets and setting
# the branch-scoped credentials/endpoint. Local storage is ephemeral on Render.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
AWS_S3_ADDRESSING_STYLE=path
AWS_PUBLIC_BUCKET_NAME=rafiki-public            # public vehicle photos and logo
AWS_PUBLIC_CUSTOM_DOMAIN=                       # e.g. media.rafikicarhire.com
AWS_PRIVATE_BUCKET_NAME=rafiki-private          # documents, invoices and receipts (private)
# For a paid Render disk mounted at /var/data, use:
# MEDIA_ROOT=/var/data/public-media
# PRIVATE_MEDIA_ROOT=/var/data/private-media

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO
